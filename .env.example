# Copy this file to .env and replace every placeholder.
# Never commit .env. It holds the secret key and optional Firebase settings.

SECRET_KEY=replace-with-a-long-random-string

# SQLite file (no MySQL server needed)
SQLITE_PATH=instance/fotoinsight.db

# Firebase Realtime Database REST API (compulsory cloud sync)
# Example: https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DB_URL=
FIREBASE_AUTH_TOKEN=

# development or production
APP_ENV=development
FLASK_DEBUG=1
