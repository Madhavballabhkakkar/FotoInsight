# Copy this file to .env and replace every placeholder.
# Never commit .env. It holds the real database password and secret key.

SECRET_KEY=replace-with-a-long-random-string
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=fotoinsight
MYSQL_PASSWORD=replace-with-the-mysql-password
MYSQL_DATABASE=fotoinsight
MYSQL_TEST_DATABASE=fotoinsight_test

# Set to 1 for cloud MySQL that requires TLS (Aiven, Railway, TiDB, etc.)
MYSQL_SSL=0

# Firebase Realtime Database REST API (compulsory cloud sync)
# Example: https://your-project-default-rtdb.firebaseio.com
FIREBASE_DB_URL=
# Optional legacy/database secret or ID token. Leave empty if rules allow open demo access.
FIREBASE_AUTH_TOKEN=

# development or production
APP_ENV=development
FLASK_DEBUG=1
